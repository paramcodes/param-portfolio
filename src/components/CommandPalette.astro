---
// Command palette. Keyboard-initiated and opened constantly, so it never
// animates: showModal() is instant, closing is instant (the frequency gate).
interface Item {
  href: string;
  title: string;
  kind: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<dialog class="cmdk" data-cmdk aria-label="Command menu">
  <div class="cmdk-panel">
    <input class="cmdk-input mono" data-cmdk-input type="text" placeholder="jump to&#8230;" autocomplete="off" spellcheck="false" />
    <ul class="cmdk-list" data-cmdk-list role="listbox" aria-label="Pages and projects">
      {
        items.map((item, i) => (
          <li role="option" aria-selected={i === 0 ? 'true' : 'false'}>
            <a class="cmdk-item" href={item.href} data-kind={item.kind}>
              <span class="cmdk-title">{item.title}</span>
              <span class="cmdk-kind mono">{item.kind}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</dialog>

<style>
  .cmdk {
    border: none;
    padding: 0;
    background: none;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
  }

  .cmdk::backdrop {
    background: rgba(10, 9, 8, 0.55);
  }

  .cmdk-panel {
    width: min(560px, 92vw);
    margin: 14vh auto 0;
    background: var(--bg);
    border: 1px solid var(--pill-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .cmdk-input {
    width: 100%;
    background: none;
    border: none;
    border-bottom: 1px solid var(--hairline);
    padding: 0.9rem 1.1rem;
    font-size: 0.9375rem;
    color: var(--text);
  }

  .cmdk-input:focus {
    outline: none;
  }

  .cmdk-input::placeholder {
    color: var(--faint);
  }

  .cmdk-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    max-height: 46vh;
    overflow-y: auto;
  }

  .cmdk-list li[aria-selected='true'] .cmdk-item {
    background: var(--hover-fill);
  }

  .cmdk-item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
  }

  .cmdk-title {
    font-size: 0.9063rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cmdk-kind {
    margin-left: auto;
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--faint);
  }

  .cmdk-item[hidden],
  .cmdk-list li[hidden] {
    display: none;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-cmdk]');
  const openButton = document.querySelector('[data-cmdk-open]');

  if (dialog && openButton) {
    const input = dialog.querySelector<HTMLInputElement>('[data-cmdk-input]');
    const list = dialog.querySelector('[data-cmdk-list]');
    const options = Array.from(dialog.querySelectorAll<HTMLElement>('[data-cmdk-list] > li'));
    let selected = 0;

    const setVisible = () => {
      const query = (input?.value ?? '').trim().toLowerCase();
      let visibleCount = 0;
      for (const li of options) {
        const title = li.querySelector('.cmdk-title')?.textContent?.toLowerCase() ?? '';
        const match = !query || title.includes(query);
        li.toggleAttribute('hidden', !match);
        if (match) visibleCount += 1;
      }
      selected = 0;
      options.filter((li) => !li.hidden).forEach((li, i) => {
        li.setAttribute('aria-selected', i === selected ? 'true' : 'false');
      });
      return visibleCount;
    };

    const select = (next: number) => {
      const visible = options.filter((li) => !li.hidden);
      if (!visible.length) return;
      selected = (next + visible.length) % visible.length;
      visible.forEach((li, i) => li.setAttribute('aria-selected', i === selected ? 'true' : 'false'));
      visible[selected].scrollIntoView({ block: 'nearest' });
    };

    const open = () => {
      if (input) input.value = '';
      setVisible();
      dialog.showModal();
      input?.focus();
    };

    openButton.addEventListener('click', open);

    window.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });

    input?.addEventListener('input', setVisible);

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        select(selected + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        select(selected - 1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const visible = options.filter((li) => !li.hidden);
        visible[selected]?.querySelector('a')?.click();
      }
    });

    // click on the backdrop closes
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    list?.addEventListener('click', () => dialog.close());
  }
</script>
