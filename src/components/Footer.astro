---
const email = 'sparamveer1001@gmail.com';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <hr class="section-rule" />
    <div class="footer-inner">
      <button class="email-pill pressable" type="button" data-copy-email data-email={email}>
        <span class="email-text" aria-live="polite">{email}</span>
        <svg class="copy-icon" width="13" height="15" viewBox="0 0 13 15" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <rect x="3.5" y="4.5" width="8" height="9" rx="1.5" />
          <path d="M9.5 4.5v-2a1.5 1.5 0 0 0-1.5-1.5H3A1.5 1.5 0 0 0 1.5 2.5v7A1.5 1.5 0 0 0 3 11h.5" />
        </svg>
      </button>
      <nav class="footer-links mono" aria-label="Elsewhere">
        <a class="text-link" href="https://github.com/paramcodes" rel="me">github</a>
        <a class="text-link" href="https://x.com/Your_PARAM" rel="me">x</a>
        <a class="text-link" href="/rss.xml">rss</a>
      </nav>
    </div>
    <p class="colophon mono">&copy; {year}, built with astro &#8212; set in inter &#38; jetbrains mono</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 1.5rem 2rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 1.25rem 0.75rem;
  }

  .email-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid var(--pill-border);
    background: var(--pill-fill);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    font-size: 0.8438rem;
    color: var(--text);
  }

  .email-text {
    transition:
      filter 200ms ease,
      opacity 200ms ease;
  }

  .email-text.is-swapping {
    filter: blur(2px);
    opacity: 0.7;
  }

  .copy-icon {
    color: var(--muted);
  }

  .footer-links {
    margin-left: auto;
    display: flex;
    gap: 1.1rem;
    font-size: 0.7813rem;
  }

  .colophon {
    font-size: 0.7188rem;
    letter-spacing: 0.03em;
    color: var(--faint);
  }
</style>

<script>
  const pill = document.querySelector('[data-copy-email]');
  if (pill) {
    const text = pill.querySelector('.email-text');
    const original = text?.textContent ?? '';
    let revertTimer = 0;

    pill.addEventListener('click', () => {
      const email = pill.getAttribute('data-email') ?? '';
      const swap = (label: string) => {
        if (!text) return;
        text.classList.add('is-swapping');
        window.setTimeout(() => {
          text.textContent = label;
          text.classList.remove('is-swapping');
        }, 100);
      };

      navigator.clipboard
        .writeText(email)
        .then(() => {
          window.clearTimeout(revertTimer);
          swap('copied to clipboard');
          revertTimer = window.setTimeout(() => swap(original), 1600);
        })
        .catch(() => swap('press ctrl+c'));
    });
  }
</script>
